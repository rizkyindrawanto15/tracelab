# ─── Supabase ────────────────────────────────────────────────────────────────
# Public values (safe for the browser). Protected by Row Level Security.
# When these are omitted TraceLab runs in "Local mode": no accounts, data is
# stored in the browser's localStorage only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the deployed site (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Server-side request proxy ───────────────────────────────────────────────
# The proxy lets TraceLab send requests to public APIs that do not allow CORS.
# It is SSRF-hardened: private, loopback, link-local and metadata addresses are
# blocked at DNS-resolution time, payloads are size-limited and timeouts capped.
# Set to "false" to disable it completely.
TRACELAB_PROXY_ENABLED=true

# NEVER put the Supabase service role key in this app. It is not required.
